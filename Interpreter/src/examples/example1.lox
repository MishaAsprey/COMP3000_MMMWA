//Root rivers fed only by rainfall

river googong [15, #1.2];
river jerrabomberra [10, #0.8];
river uMolongolo [25, #2.5];
river cMolongolo [8];
river lMolongolo [10];
river queanbeyan [12];

print cMolongolo;

googong -> queanbeyan;
queanbeyan + uMolongolo + jerrabomberra -> cMolongolo;
cMolongolo -> lMolongolo;

print cMolongolo;
print 120%;
print 5%;
print 50%;
