river rivA [15, #1.2];
river rivB [10, #0.8];
river rivC [25, #2.5];

river rivD [12];
river rivE [8];
river rivF [10];

dam damA [119000] {
  when level > 95%:   release 100%;
  when inflow > #50:  release 60%;
  default:            release 20%;
}

dam damB [28000] {
  when rain > 20:     release 100%;
  when level < 10%:   release 0%;
  default:            release 50%;
}

rivA -> damA -> rivD;
rivD + rivC + rivB -> rivE -> damB -> rivF;

print rivF;

map;
