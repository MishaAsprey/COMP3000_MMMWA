class Tokens {
    init() {
        this.counter = -1; // Counter enables enum-like functionality

// ==== OPERATORS ================================ //
        this.PLUS = this.incr();
        this.MINUS = this.incr();
        this.EQUAL = this.incr();
// ==== LITERALS ================================= //
        this.IDENTIFIER = this.incr();
        this.STRING = this.incr();
        this.NUMBER = this.incr();
        this.WATER_FLOW = this.incr();
// ==== KEYWORDS ================================= //
        this.VAR = this.incr();
        this.RIVER = this.incr();
        this.DAM = this.incr();
    }
    incr() { // Increment this.counter
        return this.counter = this.counter + 1;
    }
}

var tokens = Tokens();

// Testing the enum functionality.
print tokens.PLUS;
print tokens.IDENTIFIER;
print tokens.NUMBER;
print tokens.DAM;